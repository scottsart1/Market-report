# Copy this file to .env and fill in your keys.
#
# FRED API key (free): https://fred.stlouisfed.org/docs/api/api_key.html
# Strongly recommended. With a key the pipeline uses ALFRED first-release
# (vintage) data for revision-prone macro series, which removes most
# revision look-ahead bias from the training data. Without a key the app
# still works using FRED's public CSV endpoint (latest-vintage values) and
# configured publication lags, but historical features then contain revised
# values -- this is flagged in the dashboard's Data Health / Methodology.
FRED_API_KEY=

# Optional overrides
# RECESSION_DATA_DIR=data
# RECESSION_LOG_LEVEL=INFO
